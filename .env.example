# 复制为 .env 后改这些值：cp .env.example .env
# .env 已 gitignore，不会提交。

# 时区(仅容器启动前几毫秒 + `date` 等诊断命令的参考值)。
# 调度实际用的时区由 config 决定(settings.timezone,启动时 applyTimezone() 会覆盖 process.env.TZ,
# 不看这个 env)——查 GET /api/timezone 或启动日志 `[tz] 时区 = ...`;要改用 POST /api/timezone。
TZ=Asia/Shanghai

# Web UI 端口（宿主机）
PORT=7860

# 端口绑定的网卡。默认所有网卡（局域网 <本机IP>:7860 + Tailscale 100.x:7860 都可达）。
# 非回环访问会强制要求共享密钥（见下方 DREC_WEB_TOKEN）；只在本机用时改成回环地址最安全。
BIND=0.0.0.0

# Web 访问共享密钥（issue #600）：非回环访问必填；留空则首启在数据根 config 下生成 0600 密钥文件，
# 可用 `docker compose exec douyin-rec cat` 读取启动日志里给出的文件路径后填到这里。
# 浏览器首次打开会要求输入该密钥；API 客户端可在 Authorization 或自定义请求头里携带。
DREC_WEB_TOKEN=

# 宿主机持久化根目录（容器重建不丢）。内部布局固定，无需分别配置：
#   <DATA_ROOT>/db/douyin-rec.db            数据库（含抖音账号 cookie）
#   <DATA_ROOT>/recordings/                 录像/弹幕输出（任务未单独设 outDir 时用）
#   <DATA_ROOT>/config/biliup/cookies.json  biliup B站上传 cookie
DATA_ROOT=./docker-data

# 可选：覆盖 B站上传线路。默认 alia 优先，分块连接失败会自动换线。
# BILIUP_UPLOAD_LINE=alia
# 或用逗号列表指定完整顺序：BILIUP_UPLOAD_LINES=alia,bda2,cnbd,txa

# 可选：B站投稿提交接口。默认 web（biliup CLI 默认 app 更易触发 21566「投稿过于频繁」风控）。
# 需要回退旧行为时设 app（可选 app|web|b-cut-android）。
# BILIUP_SUBMIT=web

# 可选：Discord 通知 webhook（留空则不通知）
DISCORD_WEBHOOK=

# 可选：Web API 入口防护的 Host 白名单追加项（issue #427，逗号分隔域名）。
# 默认已放行：IP 字面量 / localhost / 单标签主机名（Tailscale MagicDNS 短名，如 master）/
# *.local / *.ts.net，端口差异忽略、末尾点归一。仅当经**自定义域名的反代**（如 nginx `server_name rec.example.com`
# 且 `proxy_set_header Host $host`）访问时才需要设，否则所有请求 403：
# 反代前提：必须 `proxy_set_header Host $host`（nginx 默认 $proxy_host 会导致 Origin 校验 403）；
# TLS 终止的反代还须 `proxy_set_header X-Forwarded-Proto $scheme`（nginx 默认不带，Caddy 默认带）。
# DREC_ALLOWED_HOSTS=rec.example.com,rec.example.org

# ────────────────────────────────────────────────────────────────────────────
# 以下仅裸跑（不用 docker，直接 `node dist/douyin-rec.mjs ...`）时生效：
# CLI 启动会自动读 <cwd>/.env（Node 内置 process.loadEnvFile，无 .env 则静默跳过）。
# docker 用不到这段——容器内数据根写死在 docker-compose.yml 的 environment 里，不受此文件影响，
# 也不会读到这个 .env（没拷进镜像）。
#
# 数据根（db/recordings/stage/config 全收在这一个目录下）。留空 = 默认 ./output-data。
# 和上面的 DATA_ROOT 是两个不同东西：DATA_ROOT 只给 docker-compose 做卷映射用；
# DOUYIN_REC_ROOT 才是代码真正读的那个变量（裸跑本地开发一般不用改，想自定义再设）。
# DOUYIN_REC_ROOT=./output-data

# 专用 env（优先级比 DOUYIN_REC_ROOT 派生路径更高，可单独覆盖某一项）：
# DOUYIN_REC_DB=./output-data/db/douyin-rec.db
# DOUYIN_REC_OUTPUT=./output-data/recordings
# BILIUP_COOKIE=./output-data/config/biliup/cookies.json
